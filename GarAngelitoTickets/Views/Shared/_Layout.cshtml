<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GarAngelitoTickets</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="glass-nav">
        <div class="nav-container">
            <a class="brand-logo" asp-controller="Boletos" asp-action="Index">
                <span class="brand-dot"></span>
                GarAngelitoTickets
            </a>
            <nav class="nav-links">
                <a class="nav-link-item" asp-controller="Boletos" asp-action="Index">Cartelera</a>
                <a class="nav-link-item" asp-controller="Boletos" asp-action="Consultar">Consultar Boletos</a>
            </nav>
        </div>
    </header>

    <main class="main-wrapper">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>