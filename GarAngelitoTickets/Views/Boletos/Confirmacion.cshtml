@model GarAngelitoTickets.Models.Boleto
@{
    ViewData["Title"] = "Confirmación de Compra";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-panel text-center">
            <span class="badge-minimal mb-2">Reserva Confirmada</span>
            <h1 class="h4 fw-semibold mb-1">@Model.Concierto?.Artista</h1>
            <p class="text-secondary small mb-4">@Model.Concierto?.Recinto · @Model.Concierto?.Fecha.ToString("dd MMM yyyy HH:mm")</p>

            @if (ViewBag.QrBase64 != null)
            {
                <div class="bg-white p-3 d-inline-block rounded mb-3">
                    <img src="@ViewBag.QrBase64" alt="Código QR del boleto" width="160" height="160" />
                </div>
            }

            <div class="mb-4">
                <span class="d-block text-secondary small mb-1">Código de validación</span>
                <span class="code-pill fs-5 fw-semibold">@Model.CodigoNumerico</span>
            </div>

            <div class="text-start p-3 rounded mb-4 small" style="background-color: var(--bg-main); border: 1px solid var(--border-subtle);">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-secondary">Titular</span>
                    <span>@Model.NombreComprador</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-secondary">Correo</span>
                    <span>@Model.Correo</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-secondary">Zona / Cantidad</span>
                    <span>@Model.Zona · @Model.Cantidad boleto(s)</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-top mt-1 pt-2" style="border-color: var(--border-subtle) !important;">
                    <span class="text-secondary">Total Pagado</span>
                    <span class="fw-semibold">@Model.TotalPagado.ToString("C")</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn-secondary-minimal flex-grow-1">Ir a Cartelera</a>
                <a asp-action="Consultar" asp-route-busqueda="@Model.CodigoNumerico" class="btn-glass flex-grow-1">Ver en Mis Boletos</a>
            </div>
        </div>
    </div>
</div>