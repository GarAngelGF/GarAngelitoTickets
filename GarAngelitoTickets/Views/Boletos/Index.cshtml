@model IEnumerable<GarAngelitoTickets.Models.Concierto>
@{
    ViewData["Title"] = "Cartelera";
}

<div class="mb-4">
    <h1 class="section-title">Cartelera de Conciertos</h1>
    <p class="section-subtitle">GarAngelitoTickets — mejor que "YaPase" desde 2026.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="glass-panel text-center py-5">
        <p class="mb-1 fw-semibold">No hay conciertos registrados en la base de datos.</p>
        <p class="text-secondary small mb-0">Verifica la tabla Conciertos en SQL Server.</p>
    </div>
}
else
{
    <div class="concerts-grid">
        @foreach (var item in Model)
        {
            <article class="concert-card">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge-minimal">@item.Fecha.ToString("dd MMM yyyy · HH:mm")</span>
                        <span class="badge-minimal">@item.CupoDisponible disponibles</span>
                    </div>

                    <h2 class="h5 fw-semibold mb-1">@item.Artista</h2>
                    @if (!string.IsNullOrWhiteSpace(item.Tour))
                    {
                        <p class="text-secondary small mb-2">@item.Tour</p>
                    }
                    <p class="text-secondary small mb-3">@item.Recinto</p>
                </div>

                <div>
                    <div class="price-row">
                        <span class="price-label">General</span>
                        <span class="price-value">@item.PrecioGeneral.ToString("C")</span>
                    </div>
                    <div class="price-row mb-3">
                        <span class="price-label">VIP</span>
                        <span class="price-value">@item.PrecioVIP.ToString("C")</span>
                    </div>

                    @if (item.CupoDisponible > 0)
                    {
                        <a asp-action="Comprar" asp-route-id="@item.Id" class="btn-glass w-100">
                            Reservar boletos
                        </a>
                    }
                    else
                    {
                        <button class="btn-glass w-100" disabled>Agotado</button>
                    }
                </div>
            </article>
        }
    </div>
}