@model IEnumerable<GarAngelitoTickets.Models.Boleto>
@{
    ViewData["Title"] = "Consultar Boletos";
}

<div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
    <div>
        <h1 class="section-title">Mis Boletos</h1>
        <p class="section-subtitle mb-0">Consulta las reservas almacenadas en la base de datos por código, correo o titular.</p>
    </div>

    <form asp-action="Consultar" method="get" class="d-flex gap-2">
        <input type="text" name="busqueda" value="@ViewBag.Busqueda" class="glass-input" placeholder="Código, nombre o correo..." style="min-width: 240px;" />
        <button type="submit" class="btn-glass">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
        {
            <a asp-action="Consultar" class="btn-secondary-minimal">Limpiar</a>
        }
    </form>
</div>

<div class="glass-panel p-0 overflow-hidden">
    @if (Model == null || !Model.Any())
    {
        <div class="p-5 text-center text-secondary">
            No se encontraron boletos registrados con ese criterio.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-minimal">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Evento</th>
                        <th>Titular</th>
                        <th>Zona</th>
                        <th>Cant.</th>
                        <th>Total</th>
                        <th>Fecha Compra</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><span class="code-pill">@b.CodigoNumerico</span></td>
                            <td>
                                <div class="fw-semibold">@b.Concierto?.Artista</div>
                                <div class="text-secondary small">@b.Concierto?.Recinto</div>
                            </td>
                            <td>
                                <div>@b.NombreComprador</div>
                                <div class="text-secondary small">@b.Correo</div>
                            </td>
                            <td><span class="badge-minimal">@b.Zona</span></td>
                            <td>@b.Cantidad</td>
                            <td class="fw-semibold">@b.TotalPagado.ToString("C")</td>
                            <td class="text-secondary small">@b.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Confirmacion" asp-route-id="@b.Id" class="btn-secondary-minimal py-1 px-2 small">
                                    Ver QR
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>