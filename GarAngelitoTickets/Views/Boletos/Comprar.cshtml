@model GarAngelitoTickets.Models.Boleto
@{
    ViewData["Title"] = "Reservar Boletos";
    var concierto = ViewBag.Concierto as GarAngelitoTickets.Models.Concierto;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-3">
            <a asp-action="Index" class="text-secondary small">&larr; Volver a la cartelera</a>
        </div>

        <div class="glass-panel">
            <div class="border-bottom pb-3 mb-4" style="border-color: var(--border-subtle) !important;">
                <span class="badge-minimal mb-2">@concierto?.Fecha.ToString("dd MMM yyyy · HH:mm")</span>
                <h1 class="h4 fw-semibold mb-1">@concierto?.Artista</h1>
                <p class="text-secondary small mb-0">@concierto?.Tour — @concierto?.Recinto</p>
            </div>

            <form asp-action="Comprar" method="post" id="formCompra" autocomplete="off">
                <input type="hidden" asp-for="ConciertoId" value="@concierto?.Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label-minimal">Nombre completo del titular</label>
                    <input asp-for="NombreComprador" class="glass-input" value="" placeholder="Nombre y apellidos" autocomplete="off" required />
                    <span asp-validation-for="NombreComprador" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-minimal">Correo electrónico</label>
                        <input asp-for="Correo" type="email" class="glass-input" value="" placeholder="correo@dominio.com" autocomplete="off" required />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-minimal">Teléfono</label>
                        <input asp-for="Telefono" class="glass-input" value="" placeholder="10 dígitos" autocomplete="off" required />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label-minimal">Zona</label>
                        <select asp-for="Zona" id="selectZona" class="glass-input">
                            <option value="General" data-precio="@concierto?.PrecioGeneral">General (@concierto?.PrecioGeneral.ToString("C"))</option>
                            <option value="VIP" data-precio="@concierto?.PrecioVIP">VIP (@concierto?.PrecioVIP.ToString("C"))</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-minimal">Cantidad (Máx. 10)</label>
                        <input asp-for="Cantidad" id="inputCantidad" type="number" min="1" max="10" value="1" class="glass-input" required />
                        <span asp-validation-for="Cantidad" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 mb-4 rounded" style="background-color: var(--bg-main); border: 1px solid var(--border-subtle);">
                    <span class="text-secondary small">Total a pagar</span>
                    <span id="labelTotal" class="h5 fw-semibold mb-0">@concierto?.PrecioGeneral.ToString("C")</span>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn-secondary-minimal">Cancelar</a>
                    <button type="submit" class="btn-glass flex-grow-1">
                        Confirmar compra
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const selectZona = document.getElementById('selectZona');
            const inputCantidad = document.getElementById('inputCantidad');
            const labelTotal = document.getElementById('labelTotal');

            function calcularTotal() {
                const option = selectZona.options[selectZona.selectedIndex];
                const precio = parseFloat(option.getAttribute('data-precio')) || 0;
                const cantidad = parseInt(inputCantidad.value) || 1;
                const total = precio * cantidad;
                labelTotal.textContent = total.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
            }

            selectZona.addEventListener('change', calcularTotal);
            inputCantidad.addEventListener('input', calcularTotal);
            calcularTotal();
        })();
    </script>
}